<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANDROID CONTROL"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alpha wuxuu kaa caawin karaa maamulka telefoonka"
            android:textColor="#AAB4D0"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/openApps"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📱 APPS"/>

        <Button
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⚙️ DEJINTA"/>

        <Button
            android:id="@+id/openFiles"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📁 FILES"/>

        <Button
            android:id="@+id/notifications"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔔 OGEYSIISYADA"/>

        <Button
            android:id="@+id/browser"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🌐 BROWSER"/>

        <TextView
            android:id="@+id/controlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nidaamka Android: diyaar"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="20dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>
