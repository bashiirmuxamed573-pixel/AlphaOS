<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALPHA OS"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DASHBOARD"
            android:textColor="#AAB4D0"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/aiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠 AI CORE     ONLINE"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="25dp"
            android:background="#151E31"/>

        <TextView
            android:id="@+id/memoryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 MEMORY      ONLINE"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="#151E31"/>

        <TextView
            android:id="@+id/voiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ VOICE       READY"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="#151E31"/>

        <TextView
            android:id="@+id/securityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 SECURITY    ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="#151E31"/>

        <TextView
            android:id="@+id/androidStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 ANDROID     CONNECTED"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="#151E31"/>

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVICE\nSamsung Galaxy A14"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="#151E31"/>

        <Button
            android:id="@+id/permissionsButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔐 MAAMUL OGOLAANSHAHA"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
