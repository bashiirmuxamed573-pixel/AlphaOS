<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#080D18">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALPHA OS"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/systemState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● NIDAAMKU WAA DIYAAR"
        android:textColor="#AAB4D0"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="5dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:layout_marginTop="25dp">

        <Button
            android:id="@+id/ai"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="🧠\nALPHA AI"/>

        <Button
            android:id="@+id/voice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="🎙️\nCOD"/>

        <Button
            android:id="@+id/memory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="💾\nXUSUUS"/>

        <Button
            android:id="@+id/android"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="📱\nANDROID"/>

        <Button
            android:id="@+id/security"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="🔐\nAMNI"/>

        <Button
            android:id="@+id/scheduler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="⏰\nJADWAL"/>

        <Button
            android:id="@+id/plugins"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="🔌\nPLUGINS"/>

        <Button
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="⚙️\nDEJINTA"/>

    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALPHA • SOMALI AI • ANDROID"
        android:textColor="#7E899F"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="10dp"/>

</LinearLayout>
