<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0B1020">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AMNIGA ALPHA"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xakamee Alpha iyo telefoonkaaga"
        android:textColor="#AAB4D0"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <Switch
        android:id="@+id/securitySwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amniga Alpha"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:checked="true"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/securityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● Amnigu waa shaqaynayaa"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:padding="20dp"
        android:layout_marginTop="20dp"/>

</LinearLayout>
