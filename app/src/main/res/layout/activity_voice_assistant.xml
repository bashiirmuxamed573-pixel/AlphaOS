<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#080D18">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALPHA VOICE"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/voiceState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diyaar ayaan ahay"
        android:textColor="#AAB4D0"
        android:textSize="18sp"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/listenButton"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:text="🎙️\nDHAGEYSO"
        android:textSize="22sp"
        android:layout_marginTop="45dp"/>

    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hadalkaaga wuxuu halkan kasoo muuqan doonaa."
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginTop="35dp"/>

    <TextView
        android:id="@+id/alphaReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alpha: Waan ku dhageysanayaa."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginTop="12dp"/>

</LinearLayout>
